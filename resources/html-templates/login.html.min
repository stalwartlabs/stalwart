holder="XXXX-XXXX" autocomplete="off" autocapitalize="characters" spellcheck="false"> </div> <div class="field" id="field-otp" hidden> <label for="otp">One-time code</label> <input id="otp" name="otp" type="text" placeholder="000000" maxlength="6" inputmode="numeric" pattern="\d{6}" autocomplete="one-time-code"> </div> <button type="submit" class="btn" id="submit-btn">Sign in</button> </form> <div id="consent" hidden> <div class="client"> <div class="tile" id="client-tile"></div> <div> <div class="client-name" id="client-name"></div> <div class="client-host" id="client-host" hidden></div> <span class="badge" id="client-unverified" hidden>Unverified application</span> </div> </div> <p class="consent-lead">If you allow it, this application will be able to:</p> <ul class="scopes" id="client-scopes"></ul> <p class="redirect-note" id="client-redirect" hidden></p> <div class="actions"> <button type="button" class="btn secondary" id="deny-btn">Deny</button> <button type="button" class="btn" id="allow-btn">Allow</button> </div> </div> </div> <script>!function(){"use strict";var e=function(e){return document.getElementById(e)},t="Temporary server failure. If the problem persists, contact your administrator.";function n(e,t){e.textContent=null==t?"":String(t)}function o(e){e&&(e.hidden=!1)}function i(e){e&&(e.hidden=!0)}function r(e){for(;e.firstChild;)e.removeChild(e.firstChild)}function a(t){var i=e("alert");i.classList.remove("success"),n(e("alert-msg"),t),o(i)}function c(){i(e("alert"))}var s=new URL(window.location.href),u=s.searchParams,l=/\/device(\/|$)/.test(s.pathname),d="?"===s.search.charAt(0)?s.search.slice(1):s.search,f=u.get("login_hint"),p=null,h=null,v="login",g=!1,m=null,y=null,b=null,w=!1;f&&(e("username").value=f);var C=["javascript:","data:","vbscript:","file:","blob:","about:"];function L(e){"string"==typeof e&&e?!function(e){try{return-1===C.indexOf(new URL(e).protocol.toLowerCase())}catch(e){return!1}}(e)?T("The application redirect address is not allow