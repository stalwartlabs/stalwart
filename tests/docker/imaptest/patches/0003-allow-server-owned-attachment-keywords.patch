+static bool mailbox_keyword_is_server_owned(const char *keyword)
+{
+	/* Keywords that a server assigns on its own, so they can show up in a
+	   FETCH FLAGS reply without ever having been advertised in an untagged
+	   FLAGS reply. test-parser.c ignores the same two in scripted FETCH
+	   FLAGS matches. */
+	static const char *const server_owned[] = {
+		"$hasattachment",
+		"$hasnoattachment",
+		NULL
+	};
+	unsigned int i;
+
+	for (i = 0; server_owned[i] != NULL; i++) {
+		if (strcasecmp(keyword, server_owned[i]) == 0)
+			return TRUE;
+	}
+	return FALSE;
+}
