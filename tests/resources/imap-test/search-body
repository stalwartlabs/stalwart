messages: all

# Stalwart writes the full-text index from an asynchronous queue
# (crates/services/src/index_queue), so a search issued straight after the
# messages are appended can match nothing at all. Let the queue drain first.
# Servers that index synchronously can set IMAP_FTS_SYNC to skip the pause.
!ifnenv IMAP_FTS_SYNC
ok noop
!sleep 2s
!endif

# search full words first
ok search text asdfghjkl
* search 1 2
ok search text zxcvbnm
* search 1 3 4
ok search text qwertyuiop
* search 2 3 4

ok search body asdfghjkl
* search 1 2
ok search body zxcvbnm
* search 1 3 4
ok search body qwertyuiop
* search 4

# Substring matching. RFC 9051 section 6.4.4 lets a server implement BODY and
# TEXT with full word matching instead, so these only run where the server
# advertises substring semantics.
!ifenv IMAP_FTS_SUBSTRING
ok search text sdfghjk
* search 1 2
ok search text xcvbn
* search 1 3 4
ok search text wertyuio
* search 2 3 4

ok search body sdfghjk
* search 1 2
ok search body xcvbn
* search 1 3 4
ok search body wertyuio
* search 4
!endif
