capabilities: THREAD=REFERENCES
state: created

# Stalwart groups THREAD results by its own JMAP thread id and emits one flat
# list per thread, rather than building the RFC 5256 REFERENCES container tree.
# The IMAP_THREAD_REFERENCES branches carry the RFC 5256 expectations; the other
# branch records what Stalwart returns today.
ok append
ok append
ok append
ok append

ok select $mailbox
ok thread references us-ascii all
!ifenv IMAP_THREAD_REFERENCES
* THREAD (1 (2 4)(3))
!else
* THREAD (1 2 3 4)
!endif

ok store 1,2 +flags \deleted
ok expunge
ok thread references us-ascii all
!ifenv IMAP_THREAD_REFERENCES
* THREAD (1)(2)
!else
* THREAD (1 2)
!endif

ok append
ok thread references us-ascii all
!ifenv IMAP_THREAD_REFERENCES
* THREAD (1)((2)(3))
!else
* THREAD (1 2 3)
!endif
