capabilities: SORT
messages: all

# Stalwart derives the base subject through mail-parser's thread_name rather than
# the seven step procedure in RFC 5256 2.1, so subjects with RFC 2047 encoded
# words, [blob] prefixes and [fwd: ...] wrappers land in different buckets. The
# IMAP_SORT_BASE_SUBJECT branches carry the RFC 5256 expectations.
ok sort (subject) us-ascii all
!ifenv IMAP_SORT_BASE_SUBJECT
* sort 9 10 1 14 3 5 11 6 15 2 7 12 13 8 4
!else
* sort 15 8 4 1 14 3 5 11 6 2 7 12 13 9 10
!endif

ok sort (reverse subject) us-ascii all
!ifenv IMAP_SORT_BASE_SUBJECT
* sort 4 8 2 7 12 13 15 6 3 5 11 14 1 9 10
!else
* sort 2 7 12 13 6 3 5 11 14 1 4 8 15 9 10
!endif

ok sort (subject reverse size) us-ascii all
!ifenv IMAP_SORT_BASE_SUBJECT
* sort 10 9 1 14 11 5 3 6 15 13 12 7 2 8 4
!else
* sort 15 8 4 1 14 11 5 3 6 13 12 7 2 10 9
!endif
